FROM postgres:16

# Install pgvector from release tarball (avoids git SSL issues)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    postgresql-server-dev-16 \
    wget \
    ca-certificates \
    && wget -q https://github.com/pgvector/pgvector/archive/refs/tags/v0.7.4.tar.gz -O /tmp/pgvector.tar.gz \
    && tar -xzf /tmp/pgvector.tar.gz -C /tmp \
    && cd /tmp/pgvector-0.7.4 && make && make install \
    && rm -rf /tmp/pgvector-0.7.4 /tmp/pgvector.tar.gz \
    && apt-get remove -y build-essential postgresql-server-dev-16 wget \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Fix collation version mismatch in template1
COPY fix-template1.sh /docker-entrypoint-initdb.d/00-fix-template1.sh
RUN chmod +x /docker-entrypoint-initdb.d/00-fix-template1.sh