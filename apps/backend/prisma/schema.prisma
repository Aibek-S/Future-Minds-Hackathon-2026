generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum AssignmentMode {
  ONLINE
  OFFLINE
}

enum AssignmentStatus {
  PENDING_VERIFICATION
  TEACHER_VERIFIED
  REVISION_REQUIRED
  AI_GRADED
}

enum RecommendationType {
  LESSON_PLAN
  REMEDIAL_TASK
  STUDENT_ALERT
}

enum RecommendationStatus {
  PENDING
  APPROVED
  REJECTED
  EDITED
}

enum MistakeType {
  CALCULATION_ERROR
  CONCEPTUAL_ERROR
  READING_ERROR
}

enum FeedbackTargetType {
  LESSON
  TUTOR_SESSION
}

enum VoiceFeedbackStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MaterialIngestionStatus {
  VECTORIZING
  COMPLETED
  FAILED
}

enum SessionKind {
  STUDENT_CHAT
  DIAGNOSTIC
  FEEDBACK
  ORCHESTRATOR
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student   Student?
  teacher   Teacher?
  feedbacks Feedback[]
  sessions  TutorSession[]
  voiceFeedbacks VoiceFeedback[]
}

model Student {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade       Int
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  goals       Json     @default("[]")
  preferences Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  knowledge   StudentKnowledge[]
  attempts    Attempt[]
  mistakes    Mistake[]
  assignments StudentAssignment[]
  sessions    TutorSession[]
}

model Teacher {
  id              String             @id @default(cuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes         Class[]
  lessons         Lesson[]
  recommendations AiRecommendation[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model Class {
  id              String             @id @default(cuid())
  code            String             @unique
  name            String
  grade           Int
  teacherId       String
  teacher         Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  students        Student[]
  lessons         Lesson[]
  assignments     Assignment[]
  recommendations AiRecommendation[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([teacherId])
}

model Lesson {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  topicId   String?
  topic     Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  date      DateTime
  planJson  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments Assignment[]
  feedbacks   Feedback[]   @relation("LessonFeedback")

  @@index([classId, date])
  @@index([topicId])
}

model Subject {
  id     String  @id @default(cuid())
  name   String  @unique
  topics Topic[]
}

model Topic {
  id            String   @id @default(cuid())
  name          String
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parentTopicId String?
  parentTopic   Topic?   @relation("TopicHierarchy", fields: [parentTopicId], references: [id], onDelete: SetNull)
  childTopics   Topic[]  @relation("TopicHierarchy")
  prerequisites String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tasks           Task[]
  knowledge       StudentKnowledge[]
  materialsVector MaterialVector[]
  materialIngestions MaterialIngestion[]
  mistakes        Mistake[]
  assignments     Assignment[]
  lessons         Lesson[]

  @@index([subjectId])
  @@index([parentTopicId])
}

model MaterialVector {
  id        String                      @id @default(cuid())
  topicId   String
  topic     Topic                       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  content   String
  metadata  Json
  embedding Unsupported("vector(1536)")

  createdAt DateTime @default(now())

  @@index([topicId])
}

model MaterialIngestion {
  id               String                  @id @default(cuid())
  topicId          String
  topic            Topic                   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  content          String
  sourceUrl        String?
  status           MaterialIngestionStatus @default(VECTORIZING)
  materialVectorId String?
  error            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([topicId, status])
}

model Task {
  id            String   @id @default(cuid())
  topicId       String
  topic         Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  difficulty    String
  content       String
  correctAnswer String?
  source        String   @default("manual")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attempts    Attempt[]
  assignments Assignment[] @relation("AssignmentTasks")

  @@index([topicId])
}

model Attempt {
  id            String   @id @default(cuid())
  taskId        String
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answer        String
  attemptNumber Int
  correct       Boolean
  createdAt     DateTime @default(now())

  @@index([studentId, taskId])
  @@index([studentId, createdAt])
}

model StudentKnowledge {
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicId         String
  topic           Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  mastery         Float    @default(0)
  attempts        Int      @default(0)
  correctAttempts Int      @default(0)
  lastActivity    DateTime @default(now()) @updatedAt

  @@id([studentId, topicId])
  @@index([studentId, mastery])
}

model Mistake {
  id        String      @id @default(cuid())
  studentId String
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type      MistakeType
  createdAt DateTime    @default(now())

  @@index([studentId, topicId])
  @@index([type])
}

model Assignment {
  id        String         @id @default(cuid())
  lessonId  String?
  lesson    Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  classId   String
  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  mode      AssignmentMode @default(ONLINE)
  isUnique  Boolean        @default(false)
  targetIds String[]
  dueDate   DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  studentAssignments StudentAssignment[]
  tasks              Task[]              @relation("AssignmentTasks")

  @@index([classId])
  @@index([topicId])
}

model StudentAssignment {
  id           String           @id @default(cuid())
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  status       AssignmentStatus @default(PENDING_VERIFICATION)
  submission   Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([studentId, assignmentId])
  @@index([assignmentId, status])
}

model TutorSession {
  id        String      @id @default(cuid())
  kind      SessionKind @default(STUDENT_CHAT)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId String?
  student   Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  messages  TutorMessage[]
  feedbacks Feedback[] @relation("SessionFeedback")

  @@index([kind, userId, createdAt])
}

model TutorMessage {
  id        String       @id @default(cuid())
  sessionId String
  session   TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  widget    Json?
  createdAt DateTime     @default(now())

  @@index([sessionId, createdAt])
}

model Feedback {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType        FeedbackTargetType
  targetId          String
  rating            Int
  commentOrAudioUrl String?
  createdAt         DateTime           @default(now())

  lesson  Lesson?       @relation("LessonFeedback", fields: [targetId], references: [id], map: "Feedback_lesson_fkey")
  session TutorSession? @relation("SessionFeedback", fields: [targetId], references: [id], map: "Feedback_session_fkey")

  @@index([targetType, targetId])
}

model VoiceFeedback {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  audioUrl   String?
  status     VoiceFeedbackStatus @default(PENDING)
  transcript String
  analysis   Json?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

model AiRecommendation {
  id        String               @id @default(cuid())
  teacherId String
  teacher   Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId   String
  class     Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  type      RecommendationType
  payload   Json
  status    RecommendationStatus @default(PENDING)
  reasoning String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([classId, status])
  @@index([teacherId, createdAt])
}
