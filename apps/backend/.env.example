# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hackathon_ai_tutor?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# App
# 3000 is commonly taken by other local projects (e.g. caspex-app container);
# backend defaults to 3002 to avoid conflicts. Change freely.
PORT=3002
NODE_ENV="development"

# LLM Providers (OpenRouter recommended for hackathon - single key for multiple models)
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Fallback providers
GEMINI_API_KEY=""
DEEPSEEK_API_KEY=""

# Embeddings
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=""

# Voice
VOICE_MODE="mock"  # "live" | "mock"

# Demo
DEMO_STUDENT_EMAIL="demo_student@hackathon.com"
DEMO_TEACHER_EMAIL="demo_teacher@hackathon.com"