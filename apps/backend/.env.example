# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hackathon_ai_tutor?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# App
# 3000 is commonly taken by other local projects (e.g. caspex-app container);
# backend defaults to 3002 to avoid conflicts. Change freely.
PORT=3002
NODE_ENV="development"

# --- AI Gateway (LLM) ---
# AI_PROVIDER: deepseek | openrouter | mock
# mock = canned local responses, works without any API keys.
AI_PROVIDER=mock

# Primary model (used when AI_PROVIDER=deepseek|openrouter)
AI_PRIMARY_MODEL=deepseek-chat

# Fallback pool (free OpenRouter models with tools support), comma-separated.
# Used in order; each gets AI_MAX_RETRIES_FALLBACK retries.
AI_FALLBACK_MODELS=z-ai/glm-5.2:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,thinkingmachines/inkling:free,nvidia/nemotron-3.5-lightning:free

# Retry / limits
AI_MAX_RETRIES_PRIMARY=2
AI_MAX_RETRIES_FALLBACK=1
AI_TIMEOUT_MS=30000
AI_MAX_CONTEXT_TOKENS=60000
AI_MAX_WIDGETS=3

# --- DeepSeek (direct API) ---
# To use for the pitch: set AI_PROVIDER=deepseek and fill DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# --- OpenRouter (fallback free models) ---
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Embeddings (later phase)
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=""

# Voice
VOICE_MODE="mock"  # "live" | "mock"

# Demo
DEMO_STUDENT_EMAIL="demo_student@hackathon.com"
DEMO_TEACHER_EMAIL="demo_teacher@hackathon.com"